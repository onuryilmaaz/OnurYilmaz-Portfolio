# systemd unit for the portfolio. Install as /etc/systemd/system/portfolio.service
[Unit]
Description=Onur Yilmaz portfolio (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/portfolio/app
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
# MY_EMAIL and MY_PASSWORD (Gmail app password) for the contact form
EnvironmentFile=/etc/portfolio.env
# Adjust if `which node` points elsewhere (e.g. nvm)
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
